---
layout: layouts/base.njk
---
<article class="article-shell">
  <header class="entry-header article-header">
    <p class="eyebrow">BITÁCORA · {{ post.post_date | formatDate }}</p>
    <h1>{{ post.post_title | decodeEntities }}</h1>
    {% if post.terms.length %}
      <div class="term-list" aria-label="Categorías">
        {% for term in post.terms %}
          {% if term.taxonomy == "category" %}
            <a class="term-chip" href="/category/{{ term.slug }}/">{{ term.name | decodeEntities }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    {% if post.featured_media and post.featured_media.url %}
      <img class="featured-image" src="{{ post.featured_media.url }}" alt="{{ post.featured_media.title | decodeEntities }}" loading="eager">
    {% endif %}
  </header>
  <div class="wp-content">{{ content | safe }}</div>
  <nav class="article-back" aria-label="Navegación del artículo">
    <a href="/blog/">← Volver a todos los artículos</a>
  </nav>
</article>

