---
layout: layouts/base.njk
---
<article class="article-shell">
  <header class="entry-header article-header">
    <p class="eyebrow">BITÁCORA · {{ date | formatDate }}</p>
    <h1>{{ title }}</h1>
    {% if categories.length %}
      <div class="term-list" aria-label="Categorías">
        {% for term in categories %}
          <a class="term-chip" href="/category/{{ term.slug }}/">{{ term.name }}</a>
        {% endfor %}
      </div>
    {% endif %}
    {% if featuredImage %}
      <img class="featured-image" src="{{ featuredImage }}" alt="{{ featuredImageAlt or title }}" loading="eager">
    {% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
  <nav class="article-back" aria-label="Navegación del artículo">
    <a href="/blog/">← Volver a todos los artículos</a>
  </nav>
</article>
