<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title | decodeEntities }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description | excerpt(160) | escape }}">
    <meta name="theme-color" content="#eaf2ff">
    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="preload" href="/assets/fonts/departure-mono.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="{{ site.title }}">
        <img class="site-avatar" src="{{ site.avatar }}" alt="" width="48" height="48">
        <span class="brand-copy">
          <strong>{{ site.title }}</strong>
          <span>{{ site.blogDescription }}</span>
        </span>
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        <a href="/" {% if active == "home" %}aria-current="page"{% endif %}>Inicio</a>
        <a href="/blog/" {% if active == "blog" %}aria-current="page"{% endif %}>Blog</a>
        <a href="/about/" {% if active == "about" or slug == "about" %}aria-current="page"{% endif %}>La leyenda</a>
      </nav>
    </header>
    <main id="main" class="site-main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <span>© {{ site.title }} · {{ site.blogDescription }}</span>
      <a href="https://github.com/ZeroDragon" rel="me">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
