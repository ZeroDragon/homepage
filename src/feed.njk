---
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title | xmlEscape }}</title>
    <link>{{ site.baseUrl }}</link>
    <description>{{ site.description | xmlEscape }}</description>
    <language>es-MX</language>
    {% for post in collections.posts %}
      <item>
        <title>{{ post.data.title | xmlEscape }}</title>
        <link>{{ site.baseUrl }}{{ post.url }}</link>
        <guid>{{ site.baseUrl }}{{ post.url }}</guid>
        <pubDate>{{ post.date | rfcDate }}</pubDate>
        <description>{{ post.data.description or post.templateContent | excerpt(220) | xmlEscape }}</description>
      </item>
    {% endfor %}
  </channel>
</rss>
