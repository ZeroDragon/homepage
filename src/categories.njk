---
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "category/{{ category.slug }}/index.html"
layout: layouts/archive.njk
title: "{{ category.name }}"
---
<header class="archive-header">
  <p class="eyebrow">CATEGORÍA · {{ category.posts.length }} ARTÍCULOS</p>
  <h1>{{ category.name | decodeEntities }}</h1>
</header>
<div class="post-list">
  {% for post in category.posts %}
    <article class="post-row">
      <time datetime="{{ post.date | dateIso }}">{{ post.date | formatDate }}</time>
      <div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description or post.templateContent | excerpt(190) }}</p>
      </div>
    </article>
  {% endfor %}
</div>
