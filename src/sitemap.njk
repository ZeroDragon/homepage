---
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for contentPage in collections.pages %}
    <url><loc>{{ site.baseUrl }}{{ contentPage.url }}</loc></url>
  {% endfor %}
  {% for post in collections.posts %}
    <url><loc>{{ site.baseUrl }}{{ post.url }}</loc></url>
  {% endfor %}
  {% for category in collections.categories %}
    <url><loc>{{ site.baseUrl }}/category/{{ category.slug }}/</loc></url>
  {% endfor %}
  {% for tag in collections.tags %}
    <url><loc>{{ site.baseUrl }}/tag/{{ tag.slug }}/</loc></url>
  {% endfor %}
</urlset>
