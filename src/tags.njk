---
pagination:
  data: collections.tags
  size: 1
  alias: tag
permalink: "tag/{{ tag.slug }}/index.html"
layout: layouts/archive.njk
title: "{{ tag.name }}"
---
<header class="archive-header">
  <p class="eyebrow">ETIQUETA · {{ tag.posts.length }} ARTÍCULOS</p>
  <h1>{{ tag.name | decodeEntities }}</h1>
</header>
<div class="post-list">
  {% for post in tag.posts %}
    <article class="post-row">
      <time datetime="{{ post.date | dateIso }}">{{ post.date | formatDate }}</time>
      <div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description or post.templateContent | excerpt(190) }}</p>
      </div>
    </article>
  {% endfor %}
</div>
